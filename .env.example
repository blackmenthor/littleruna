# Copy to .env for local Astro dev, and set the same names in Cloudflare.
# PUBLIC_ variables are baked in at build time. They must exist during `npm run build`.

PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server-only. Used by the contact endpoint. Never prefix these with PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Little Runa <hello@your-domain.com>
