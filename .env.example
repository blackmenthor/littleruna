# Copy to .env for local Astro dev, and set the same PUBLIC_ names as GitHub Actions variables.
# PUBLIC_ variables are baked in at build time. They must exist during `npm run build`.
# Leave a value blank to skip that feature. The site still builds.

PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Web Analytics site token. Cookieless. Empty skips the beacon.
PUBLIC_CF_BEACON_TOKEN=

# GA4 measurement id, like G-XXXXXXXX. Empty skips Google Analytics.
PUBLIC_GA4_ID=

# Server-only. Used by the contact and waitlist endpoints. Never prefix these with PUBLIC_.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Little Runa <hello@your-domain.com>
