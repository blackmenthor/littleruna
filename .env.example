# Copy to .env for local Astro dev, and set the same PUBLIC_ names in GitHub
# Actions (repository variables or secrets) so production builds include them.
# PUBLIC_ variables are baked in at build time. They must exist during `npm run build`.

PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Web Analytics site token, from the beacon snippet. Leave blank to skip the beacon.
PUBLIC_CF_BEACON_TOKEN=
# GA4 measurement id, like G-XXXXXXXX. Leave blank to skip Google Analytics.
PUBLIC_GA4_ID=

# Server-only. Used by the contact and newsletter endpoints. Never prefix these with PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Little Runa <hello@your-domain.com>
# Resend segment id. Audiences were renamed to Segments. The value is the segment id.
RESEND_AUDIENCE_ID=
