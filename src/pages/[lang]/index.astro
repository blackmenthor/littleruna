---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { isLocale, localePath, type Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import { featuredStyles, styles } from '../../lib/styles';
import { getArticles } from '../../lib/journal';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'id' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) {
  return Astro.redirect('/en');
}
const locale: Locale = lang;
const copy = t(locale);
const featured = featuredStyles();
const articles = (await getArticles()).slice(0, 2);
const [lead, ...rest] = featured;
---

<Base locale={locale}>
  <section class="mx-auto grid max-w-6xl gap-3 px-4 py-6 md:grid-cols-2 md:px-6 md:py-8">
    {
      lead && (
        <a class="group relative block min-h-[70vh] overflow-hidden bg-line md:row-span-2" href={localePath(locale, `/styles/${lead.slug}`)}>
          <Image src={lead.images[0]} alt={lead.name} class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" widths={[640, 960, 1400]} sizes="(min-width: 768px) 50vw, 100vw" />
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent p-6 text-paper">
            <span class="eyebrow block text-paper/80">{copy.viewStyle}</span>
            <span class="wordmark mt-1 block text-4xl uppercase">{lead.name}</span>
          </span>
        </a>
      )
    }
    <div class="grid gap-3">
      {
        rest.map((style) => (
          <a class="group relative block min-h-64 overflow-hidden bg-line" href={localePath(locale, `/styles/${style.slug}`)}>
            <Image src={style.images[0]} alt={style.name} class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent p-5 text-paper">
              <span class="wordmark block text-3xl uppercase">{style.name}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 text-center md:px-6">
    <p class="eyebrow text-rose">{copy.heroEyebrow}</p>
    <h1 class="wordmark mt-3 text-5xl leading-none md:text-6xl">{copy.heroTitle}</h1>
    <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-muted">{copy.heroText}</p>
  </section>

  <section class="border-y border-line">
    <div class="mx-auto flex max-w-6xl items-end justify-between px-4 pt-10 md:px-6">
      <div>
        <h2 class="wordmark text-4xl">{copy.stylesTitle}</h2>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{copy.stylesLead}</p>
      </div>
      <a class="eyebrow hidden text-ink hover:text-rose md:inline" href={localePath(locale, '/styles')}>{copy.allStyles}</a>
    </div>
    <div class="mt-6 flex gap-3 overflow-x-auto px-4 pb-10 md:px-6">
      {
        styles.map((style) => (
          <a class="group w-44 shrink-0" href={localePath(locale, `/styles/${style.slug}`)}>
            <span class="block aspect-[3/4] overflow-hidden bg-line">
              <Image src={style.images[0]} alt="" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" widths={[240, 400]} sizes="176px" />
            </span>
            <span class="eyebrow mt-3 block">{style.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-16 md:grid-cols-2 md:px-6">
    <div>
      <h2 class="wordmark text-4xl">{copy.storyTitle}</h2>
      <p class="mt-4 max-w-md leading-7 text-muted">{copy.storyText}</p>
      <a class="eyebrow mt-6 inline-block hover:text-rose" href={localePath(locale, '/about')}>{copy.storyLink}</a>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        copy.points.map((point) => (
          <li class="border-t border-line pt-4">
            <p class="eyebrow">{point.title}</p>
            <p class="mt-2 text-sm leading-6 text-muted">{point.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    articles.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
          <h2 class="wordmark text-4xl">{copy.journalTitle}</h2>
          <p class="mt-2 text-sm text-muted">{copy.journalLead}</p>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {articles.map((article) => (
              <a class="border-t border-line pt-4 hover:text-rose" href={localePath(locale, `/journal/${article.slug}`)}>
                {
                  article.image && (
                    <img src={article.image.url} alt="" class="mb-4 aspect-[4/3] w-full bg-line object-cover" width="800" height="600" />
                  )
                }
                <time class="eyebrow text-muted" datetime={article.publishedAt}>{article.publishedAt}</time>
                <h3 class="wordmark mt-2 text-3xl text-ink">{article.title[locale]}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{article.excerpt[locale]}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
