---
import Base from '../../../layouts/Base.astro';
import { isLocale, localePath, locales, type Locale } from '../../../i18n/locale';
import { t } from '../../../i18n/ui';
import { getArticles } from '../../../lib/journal';

export async function getStaticPaths() {
  const articles = await getArticles();
  return locales.flatMap((lang) =>
    articles.map((article) => ({
      params: { lang, slug: article.slug },
      props: { article },
    })),
  );
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/en/journal');
const locale: Locale = lang;
const { article } = Astro.props;
const copy = t(locale);
const paragraphs = article.body[locale].split(/\n\n+/).filter(Boolean);
---

<Base locale={locale} title={article.title[locale]} description={article.excerpt[locale]}>
  <article class="mx-auto max-w-2xl px-4 py-12 md:px-6">
    <a class="eyebrow text-muted hover:text-rose" href={localePath(locale, '/journal')}>{copy.journalTitle}</a>
    <time class="eyebrow mt-6 block text-rose" datetime={article.publishedAt}>{article.publishedAt}</time>
    <h1 class="wordmark mt-3 text-5xl leading-tight">{article.title[locale]}</h1>
    <p class="mt-4 text-lg leading-8 text-muted">{article.excerpt[locale]}</p>
    {
      article.image && (
        <img
          src={article.image.url}
          alt={article.image.alt}
          class="mt-8 w-full bg-line object-cover"
          width="1600"
          height="1200"
        />
      )
    }
    <div class="mt-8 space-y-5 text-base leading-8">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>
</Base>
