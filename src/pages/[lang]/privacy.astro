---
import Base from '../../layouts/Base.astro';
import { isLocale, type Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'id' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/en');
const locale: Locale = lang;
const copy = t(locale);

const paragraphs =
  locale === 'en'
    ? [
        'The contact form sends your name, email address, region, and message to Little Runa so a reply can be written. The message is delivered by Resend and is kept in that provider’s logs according to their retention.',
        'The site does not create an account and does not take payment. Articles are published by the studio; they do not collect anything from a reader.',
        'If you want a message deleted, write again from the same address and say so.',
      ]
    : [
        'Formulir kontak mengirim nama, alamat email, wilayah, dan pesan ke Little Runa supaya bisa dibalas. Pesan diantar oleh Resend dan tersimpan di log penyedia itu sesuai masa simpan mereka.',
        'Situs ini tidak membuat akun dan tidak menerima pembayaran. Artikel diterbitkan dari studio; artikel tidak mengumpulkan apa pun dari pembaca.',
        'Kalau sebuah pesan ingin dihapus, tulis lagi dari alamat yang sama dan sampaikan.',
      ];
---

<Base locale={locale} title={copy.privacyTitle}>
  <article class="mx-auto max-w-2xl px-4 py-12 md:px-6">
    <h1 class="wordmark text-5xl">{copy.privacyTitle}</h1>
    <div class="mt-8 space-y-5 leading-8">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>
</Base>
