---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { swapLocale, type Locale } from '../i18n/locale';
import { getSiteSeo } from '../lib/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const seo = await getSiteSeo();
const pageTitle = title ? `${title} · ${seo.name[locale]}` : seo.title[locale];
const pageDescription = description ?? seo.description[locale];
const origin = Astro.site ?? new URL('https://littleruna.com');
const canonical = new URL(Astro.url.pathname, origin);
const alternate = (next: Locale) => new URL(swapLocale(Astro.url.pathname, next), origin);
const phrases = [...new Set([...seo.phrases.en, ...seo.phrases.id])];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: seo.name[locale],
  description: pageDescription,
  url: origin.href,
  areaServed: ['Europe', 'Indonesia'],
  knowsAbout: phrases,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={alternate('en').href} />
    <link rel="alternate" hreflang="id" href={alternate('id').href} />
    <link rel="alternate" hreflang="x-default" href={alternate('en').href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'id' ? 'en_GB' : 'id_ID'} />
    <meta property="og:site_name" content={seo.name[locale]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Outfit:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen antialiased">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
